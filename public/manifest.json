{
  "manifest_version": 3,
  "name": "Apples to Apples Unit Price Compare",
  "short_name": "Apples Unit",
  "version": "0.3.0",
  "description": "Normalize unit prices on shopping pages so weight, volume, count, and area comparisons are easier to trust.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Compare unit prices",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
