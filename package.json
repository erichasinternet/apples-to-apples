{
  "name": "apples-to-apples",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome extension for normalized unit-price comparison across shopping sites.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichasinternet/apples-to-apples.git"
  },
  "bugs": {
    "url": "https://github.com/erichasinternet/apples-to-apples/issues"
  },
  "homepage": "https://github.com/erichasinternet/apples-to-apples#readme",
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "postcss": "8.5.25"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "release:assets": "bun run build && bun scripts/render-store-assets.ts",
    "release:validate": "bun scripts/validate-extension-release.ts",
    "release:tag:validate": "bun scripts/validate-release-tag.ts",
    "release:package": "bun scripts/package-extension.ts",
    "release": "bun run ci && bun run release:assets && bun run release:package",
    "ci": "bun run verify && bun run test:e2e",
    "prepare": "husky",
    "precommit": "bun run verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:live": "bun run build && LIVE_SHOPPING_TESTS=1 playwright test tests/e2e/live-sites.spec.ts",
    "benchmark:collect": "bun scripts/collect-live-corpus.ts",
    "benchmark:collect:bounded": "bun scripts/collect-live-corpus-bounded.ts",
    "benchmark:coverage": "bun scripts/report-corpus-coverage.ts",
    "benchmark:evaluate": "bun scripts/evaluate-live-corpus.ts",
    "benchmark:model:evaluate": "bun scripts/evaluate-model-corpus.ts",
    "benchmark:model:validate": "bun scripts/validate-model-extraction.ts",
    "benchmark:training:export": "bun scripts/export-training-corpus.ts",
    "benchmark:validate": "bun scripts/validate-live-corpus.ts",
    "dataset:readiness": "bun scripts/report-ideal-dataset-readiness.ts",
    "dataset:huggingface:prepare": "bun scripts/prepare-huggingface-dataset.ts",
    "dataset:huggingface:validate": "bun scripts/validate-huggingface-dataset.ts",
    "dataset:domains:validate": "bun scripts/validate-domain-qualification.ts",
    "dataset:depth:promote": "bun scripts/promote-training-depth-captures.ts",
    "dataset:captures:promote": "bun scripts/promote-training-depth-captures.ts",
    "dataset:captures:audit-roots": "bun scripts/audit-candidate-root-independence.ts",
    "dataset:captures:machine-gates": "bun scripts/report-capture-machine-gates.ts",
    "dataset:captures:review-sheets": "bun scripts/build-card-review-sheets.ts",
    "dataset:heldout:rank": "bun scripts/rank-heldout-candidates.ts",
    "dataset:reviews:queue": "bun scripts/build-evidence-review-queue.ts",
    "dataset:reviews:candidates": "bun scripts/list-evidence-candidates.ts",
    "dataset:reviews:score": "bun scripts/score-evidence-reviews.ts",
    "dataset:reviews:compile": "bun scripts/compile-evidence-adjudication.ts",
    "dataset:reviews:campaign": "bun scripts/merge-evidence-review-queues.ts",
    "dataset:reviews:batches": "bun scripts/build-evidence-review-batches.ts",
    "dataset:reviews:batches:validate": "bun scripts/validate-evidence-review-batches.ts",
    "dataset:reviews:campaign-report": "bun scripts/build-evidence-review-campaign-report.ts",
    "dataset:reviews:audit": "bun scripts/audit-evidence-review-campaign.ts",
    "dataset:reviews:adjudication-queue": "bun scripts/build-evidence-adjudication-queue.ts",
    "dataset:reviews:adjudication-compile": "bun scripts/compile-evidence-adjudication-campaign.ts",
    "dataset:reviews:validate": "bun scripts/validate-review-campaigns.ts",
    "dataset:reviews:serve": "bun scripts/serve-evidence-review.ts",
    "dataset:reviews:workbench-validate": "bun scripts/validate-evidence-review-workbench.ts",
    "training:prepare": "bun scripts/prepare-t5-training.ts",
    "training:autoresearch:validate": "bun scripts/validate-autoresearch.ts",
    "training:readiness": "bun scripts/report-training-readiness.ts",
    "training:inference:prepare": "bun scripts/prepare-live-inference.ts --stage discovery --split validation benchmark-data/live/*",
    "training:inference:discover": "uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-live/discovery-predictions.jsonl --checkpoint replay",
    "training:inference:discover:real-adapted": "uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-live/discovery-predictions-real-adapted.jsonl --checkpoint real-discovery",
    "training:inference:analyze-discovery": "bun scripts/analyze-live-discovery.ts",
    "training:inference:prepare-extraction": "bun scripts/prepare-live-inference.ts --stage extraction --predictions benchmark-data/inference/t5gemma2-live/discovery-predictions-real-adapted.jsonl",
    "training:inference:extract": "uvx modal run training/modal_infer.py --records extraction.jsonl --output benchmark-data/inference/t5gemma2-live/extraction-predictions.jsonl --checkpoint replay",
    "training:inference:review-queue": "bun scripts/build-live-review-queue.ts",
    "training:extraction:evaluation:prepare": "bun scripts/prepare-extraction-evaluation.ts",
    "training:extraction:evaluation:score": "bun scripts/score-extraction-evaluation.ts",
    "training:pointer:g1:prepare": "bun scripts/prepare-evidence-pointer-g1.ts",
    "training:pointer:g1:score": "bun scripts/score-evidence-pointer-evaluation.ts",
    "training:pointer:g1:validate": "python3 training/train_t5gemma2.py --config training/t5gemma2-1b/evidence-pointer-g1.json --validate-only --max-train-records 320 --max-validation-records 32 --train-task extract-product --balance-extraction-abstentions",
    "training:pointer:g1:train": "uvx modal run --detach training/modal_train.py --mode pilot-1b-evidence-pointer-g1",
    "training:pointer:g1:infer": "ATA_INFERENCE_BUNDLE=t5gemma2-evidence-pointer-g1 uvx modal run training/modal_infer.py --records extraction.jsonl --output benchmark-data/inference/t5gemma2-evidence-pointer-g1/predictions-1b-evidence-pointer-g1.jsonl --checkpoint 1b-evidence-pointer-g1 --max-output-tokens 128",
    "training:extraction:evaluation:infer:1b": "ATA_INFERENCE_BUNDLE=t5gemma2-extraction-pilot uvx modal run training/modal_infer.py --records extraction.jsonl --output benchmark-data/inference/t5gemma2-extraction-pilot/predictions-1b-explicit-contract.jsonl --checkpoint 1b-explicit-contract --max-output-tokens 768",
    "training:extraction:evaluation:infer:qwen": "ATA_INFERENCE_BUNDLE=t5gemma2-extraction-pilot uvx modal run training/modal_infer.py --records extraction.jsonl --output benchmark-data/inference/t5gemma2-extraction-pilot/predictions-qwen3-vl-zero-shot.jsonl --checkpoint qwen3-vl-zero-shot --max-output-tokens 384",
    "training:selection:prepare": "bun scripts/prepare-live-inference.ts --stage discovery --split selection --output benchmark-data/inference/t5gemma2-selection benchmark-data/live/*",
    "training:selection:discover": "ATA_INFERENCE_BUNDLE=t5gemma2-selection uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-selection/discovery-predictions-real-adapted.jsonl --checkpoint real-discovery",
    "training:selection:discover:balanced": "ATA_INFERENCE_BUNDLE=t5gemma2-selection uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-selection/discovery-predictions-balanced-real-adapted.jsonl --checkpoint balanced-real-discovery",
    "training:selection:discover:adjudicated": "ATA_INFERENCE_BUNDLE=t5gemma2-selection uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-selection/discovery-predictions-adjudicated-real-adapted.jsonl --checkpoint adjudicated-discovery",
    "training:heldout:prepare": "bun scripts/prepare-live-inference.ts --stage discovery --split heldOut --output benchmark-data/inference/t5gemma2-heldout benchmark-data/live/*",
    "training:heldout:discover": "ATA_INFERENCE_BUNDLE=t5gemma2-heldout uvx modal run training/modal_infer.py --records discovery.jsonl --output benchmark-data/inference/t5gemma2-heldout/discovery-predictions-balanced-real-adapted.jsonl --checkpoint balanced-real-discovery",
    "training:heldout:review-queue": "bun scripts/build-discovery-review-queue.ts",
    "training:heldout:score-review-a": "bun scripts/score-discovery-review.ts",
    "training:review:qwen:smoke": "ATA_REVIEW_BUNDLE=t5gemma2-live uvx modal run training/modal_review.py --max-records 1 --output benchmark-data/inference/t5gemma2-live/qwen-review-smoke.jsonl",
    "training:review:qwen:development": "ATA_REVIEW_BUNDLE=t5gemma2-live uvx modal run training/modal_review.py --output benchmark-data/inference/t5gemma2-live/qwen-review.jsonl",
    "training:review:qwen:heldout": "ATA_REVIEW_BUNDLE=t5gemma2-heldout uvx modal run training/modal_review.py --output benchmark-data/inference/t5gemma2-heldout/qwen-review.jsonl",
    "training:review:qwen:map-development": "bun scripts/map-visual-review.ts benchmark-data/inference/t5gemma2-live",
    "training:review:qwen:map-heldout": "bun scripts/map-visual-review.ts benchmark-data/inference/t5gemma2-heldout",
    "training:review:qwen:artifact-heldout": "bun scripts/build-visual-review-artifact.ts",
    "training:adjudicated:prepare": "bun scripts/prepare-adjudicated-discovery.ts --sources benchmarks/reviews/adjudicated-development-sources.json",
    "training:adjudicated:extraction-queue": "bun scripts/build-extraction-annotation-queue.ts",
    "training:campaign:extraction-queue": "bun scripts/build-campaign-extraction-queue.ts",
    "training:extraction:preannotate": "bun scripts/build-extraction-preannotations.ts",
    "training:extraction:audit": "bun scripts/audit-extraction-preannotations.ts",
    "audit:false-positives": "bun scripts/run-unit-price-audit-batched.ts",
    "audit:false-positives:part": "bun scripts/audit-unit-price-false-positives.ts",
    "audit:false-positives:merge": "bun scripts/merge-unit-price-audit-parts.ts",
    "audit:false-positives:review": "uvx modal run training/modal_unit_price_review.py",
    "audit:false-positives:review:summary": "bun scripts/summarize-unit-price-reviews.ts",
    "training:extraction:prepare": "bun scripts/prepare-silver-extraction.ts",
    "training:extraction:validate": "python3 training/train_t5gemma2.py --config training/t5gemma2-270m/audited-silver-extraction.json --validate-only",
    "training:adjudicated:validate": "python3 training/train_t5gemma2.py --config training/t5gemma2-270m/adjudicated-discovery-adaptation.json --validate-only",
    "training:baseline:flan:validate": "python3 training/train_flan_t5.py --validate-only --max-train-records 320 --max-validation-records 32",
    "training:baseline:flan:train": "uvx modal run training/modal_baselines.py --mode train-flan",
    "training:baseline:flan:selection": "ATA_INFERENCE_BUNDLE=t5gemma2-selection-instacart uvx modal run training/modal_baselines.py --mode infer-flan --output benchmark-data/inference/t5gemma2-selection-instacart/discovery-predictions-flan-t5-base.jsonl",
    "training:baseline:pix2struct:validate": "python3 training/train_pix2struct.py --validate-only --max-train-records 160 --max-validation-records 16",
    "training:baseline:pix2struct:smoke": "uvx modal run training/modal_baselines.py --mode smoke-pix2struct",
    "training:baseline:pix2struct:train": "uvx modal run training/modal_baselines.py --mode train-pix2struct",
    "training:baseline:pix2struct:continue": "uvx modal run training/modal_baselines.py --mode continue-pix2struct",
    "training:baseline:pix2struct:compact": "uvx modal run training/modal_baselines.py --mode train-pix2struct-compact",
    "training:baseline:pix2struct:compact:validate": "python3 training/train_pix2struct.py --config training/pix2struct-base/discovery-compact-baseline.json --validate-only --max-train-records 160 --max-validation-records 16",
    "training:baseline:pix2struct:selection": "ATA_INFERENCE_BUNDLE=t5gemma2-selection-instacart uvx modal run training/modal_baselines.py --mode infer-pix2struct --output benchmark-data/inference/t5gemma2-selection-instacart/discovery-predictions-pix2struct-base-boxes.jsonl",
    "training:baseline:pix2struct:selection:100": "ATA_INFERENCE_BUNDLE=t5gemma2-selection-instacart ATA_PIX2STRUCT_CHECKPOINT=pix2struct-base-discovery-pilot-100 uvx modal run training/modal_baselines.py --mode infer-pix2struct --output benchmark-data/inference/t5gemma2-selection-instacart/discovery-predictions-pix2struct-base-100-boxes.jsonl",
    "training:baseline:pix2struct:selection:compact": "ATA_INFERENCE_BUNDLE=t5gemma2-selection-instacart ATA_PIX2STRUCT_CHECKPOINT=pix2struct-base-discovery-compact-pilot-40 ATA_PIX2STRUCT_TARGET_FORMAT=compact-tags uvx modal run training/modal_baselines.py --mode infer-pix2struct --output benchmark-data/inference/t5gemma2-selection-instacart/discovery-predictions-pix2struct-base-compact-boxes.jsonl",
    "training:baseline:markuplm:validate": "python3 training/train_markuplm.py --validate-only --max-train-records 320 --max-validation-records 64",
    "training:baseline:markuplm:train": "uvx modal run training/modal_baselines.py --mode train-markuplm",
    "training:baseline:markuplm:selection": "ATA_INFERENCE_BUNDLE=t5gemma2-selection-instacart uvx modal run training/modal_baselines.py --mode infer-markuplm --output benchmark-data/inference/t5gemma2-selection-instacart/discovery-predictions-markuplm-base.jsonl",
    "training:silver:prepare": "bun scripts/prepare-silver-discovery.ts benchmark-data/live/*",
    "training:silver:validate": "python3 training/train_t5gemma2.py --config training/t5gemma2-270m/silver-discovery-adaptation.json --validate-only",
    "training:run:hybrid": "uv run --project training python training/train_t5gemma2.py --config training/t5gemma2-270m/hybrid-finetune.json",
    "training:modal:diagnose": "ATA_MODAL_DIAGNOSE_ONLY=1 uvx modal run training/modal_train.py --mode diagnose",
    "training:modal:smoke": "uvx modal run training/modal_train.py --mode smoke",
    "training:modal:pilot": "uvx modal run training/modal_train.py --mode pilot",
    "training:modal:pilot:continue": "uvx modal run training/modal_train.py --mode pilot-continue",
    "training:modal:pilot:focus": "uvx modal run training/modal_train.py --mode pilot-focus-extraction",
    "training:modal:pilot:replay": "uvx modal run training/modal_train.py --mode pilot-replay",
    "training:modal:pilot:real-discovery": "uvx modal run training/modal_train.py --mode pilot-real-discovery",
    "training:modal:pilot:balanced-real-discovery": "uvx modal run training/modal_train.py --mode pilot-balanced-real-discovery",
    "training:modal:pilot:adjudicated-discovery": "uvx modal run training/modal_train.py --mode pilot-adjudicated-discovery",
    "training:modal:pilot:expanded-adjudicated-discovery": "uvx modal run training/modal_train.py --mode pilot-expanded-adjudicated-discovery",
    "training:modal:pilot:audited-extraction": "uvx modal run training/modal_train.py --mode pilot-audited-extraction",
    "training:modal:pilot:audited-extraction:1b": "uvx modal run training/modal_train.py --mode pilot-1b-audited-extraction",
    "training:modal:pilot:audited-extraction:1b-continue": "uvx modal run training/modal_train.py --mode pilot-1b-explicit-contract-continue",
    "training:modal:check-candidates": "uvx modal run training/modal_train.py --mode check-candidates",
    "training:modal:full": "uvx modal run training/modal_train.py --mode full",
    "training:run": "uv run --project training python training/train_t5gemma2.py",
    "training:run:synthetic": "uv run --project training python training/train_t5gemma2.py --config training/t5gemma2-270m/synthetic-pretrain.json",
    "training:sync": "uv sync --project training",
    "training:synthetic:generate": "bun scripts/generate-synthetic-training.ts --output benchmark-data/training/t5gemma2-synthetic-pointer --target-format evidence-pointer",
    "training:synthetic:selection:generate": "bun scripts/generate-synthetic-selection-training.ts",
    "training:selection:representation:audit": "bun scripts/audit-live-selection-representation.ts",
    "training:synthetic:audit": "bun scripts/audit-synthetic-pointer-dataset.ts",
    "training:synthetic:validate": "python3 training/train_t5gemma2.py --config training/t5gemma2-270m/synthetic-pretrain.json --validate-only",
    "training:validate": "python3 training/train_t5gemma2.py --validate-only",
    "serve:fixtures": "bun scripts/serve-fixtures.mjs",
    "verify": "bun run typecheck && bun run test && bun run dataset:domains:validate && bun run dataset:reviews:validate && bun run training:autoresearch:validate && bun run training:baseline:markuplm:test",
    "training:baseline:markuplm:test": "python3 training/test_infer_markuplm.py && python3 training/test_train_t5gemma2.py"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.326",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
